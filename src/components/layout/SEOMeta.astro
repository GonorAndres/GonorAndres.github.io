---
import type { Lang } from '../../i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  url?: string;
  type?: 'website' | 'article';
  lang?: Lang;
  datePublished?: string;
  dateModified?: string;
  noindex?: boolean;
  schemaType?: 'webpage' | 'profile';
  imageAlt?: string;
  section?: string;
  tags?: string[];
  structuredDescription?: string;
  contentTitle?: string;
  articleSchema?: 'Article' | 'BlogPosting';
}

const siteUrl = 'https://gonor.me';
const {
  title,
  description,
  image = `${siteUrl}/og-default.png`,
  url = Astro.url.href,
  type = 'website',
  lang = 'es',
  datePublished,
  dateModified,
  noindex = false,
  schemaType = 'webpage',
  imageAlt = title,
  section,
  tags = [],
  structuredDescription = description,
  contentTitle = title,
  articleSchema = 'Article',
} = Astro.props;

const canonicalUrl = new URL(url, siteUrl).href;
const imageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;

const AUTHOR_NAME = 'Andrés González Ortega';
const SAME_AS = [
  'https://github.com/GonorAndres',
  'https://www.linkedin.com/in/andr%C3%A9s-g%C3%B3nzalez-ortega-190b49371/',
];

// hreflang: derive the paired-language URL from the current path.
const path = new URL(canonicalUrl).pathname;
let esPath: string;
let enPath: string;
if (lang === 'en') {
  enPath = path;
  esPath = path.replace(/^\/en/, '') || '/';
} else {
  esPath = path;
  enPath = path === '/' ? '/en/' : `/en${path}`;
}
const esHref = new URL(esPath, siteUrl).href;
const enHref = new URL(enPath, siteUrl).href;

const person = {
  '@id': `${siteUrl}/about/#person`,
  '@type': 'Person',
  name: AUTHOR_NAME,
  url: `${siteUrl}/about/`,
  sameAs: SAME_AS,
};

const website = {
  '@id': `${siteUrl}/#website`,
  '@type': 'WebSite',
  url: `${siteUrl}/`,
  name: AUTHOR_NAME,
  inLanguage: ['es', 'en'],
  publisher: { '@id': `${siteUrl}/about/#person` },
};

const pageEntity = type === 'article'
  ? {
      '@id': `${canonicalUrl}#article`,
      '@type': articleSchema,
      headline: contentTitle,
      description: structuredDescription,
      image: imageUrl,
      url: canonicalUrl,
      mainEntityOfPage: { '@id': canonicalUrl },
      inLanguage: lang,
      ...(datePublished ? { datePublished } : {}),
      ...(dateModified ? { dateModified } : datePublished ? { dateModified: datePublished } : {}),
      ...(section ? { articleSection: section } : {}),
      ...(tags.length ? { keywords: tags.join(', ') } : {}),
      author: { '@id': `${siteUrl}/about/#person` },
      publisher: { '@id': `${siteUrl}/about/#person` },
      isPartOf: { '@id': `${siteUrl}/#website` },
    }
  : schemaType === 'profile'
    ? {
        '@id': canonicalUrl,
        '@type': 'ProfilePage',
        url: canonicalUrl,
        name: title,
        description,
        inLanguage: lang,
        isPartOf: { '@id': `${siteUrl}/#website` },
        mainEntity: { '@id': `${siteUrl}/about/#person` },
      }
  : {
      '@id': canonicalUrl,
      '@type': 'WebPage',
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: lang,
      isPartOf: { '@id': `${siteUrl}/#website` },
      about: { '@id': `${siteUrl}/about/#person` },
    };

const personEntity = {
  ...person,
  jobTitle: lang === 'es' ? 'Actuario y Científico de Datos' : 'Actuary & Data Scientist',
  description: lang === 'es'
    ? 'Actuario y científico de datos formado en la UNAM, especializado en herramientas actuariales, seguros, regulación mexicana y plataformas de datos.'
    : 'UNAM-trained actuary and data scientist specializing in actuarial tools, insurance, Mexican regulation, and data platforms.',
  email: 'mailto:gonorandres@ciencias.unam.mx',
  knowsLanguage: ['es', 'en'],
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidad Nacional Autónoma de México',
    department: 'Facultad de Ciencias',
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [website, personEntity, pageEntity],
};
---

<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonicalUrl} />}
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- hreflang alternates -->
{!noindex && (
  <>
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={esHref} />
  </>
)}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
<meta property="og:site_name" content="Andrés González Ortega" />
{type === 'article' && datePublished && (
  <meta property="article:published_time" content={datePublished} />
)}
{type === 'article' && (dateModified || datePublished) && (
  <meta property="article:modified_time" content={dateModified ?? datePublished} />
)}
{type === 'article' && <meta property="article:author" content={AUTHOR_NAME} />}
{type === 'article' && section && <meta property="article:section" content={section} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
